# Copy to /var/lib/tethermark/config/tethermark.env, replace every required
# value, then set owner tethermark:tethermark and mode 0600.
HARNESS_ENV_FILE=/var/lib/tethermark/config/tethermark.env
HARNESS_ARTIFACT_ROOT=/var/lib/tethermark/artifacts
HARNESS_LOCAL_DB_ROOT=/var/lib/tethermark/state/local-db
HARNESS_API_HOST=127.0.0.1
WEB_UI_HOST=127.0.0.1
HARNESS_API_AUTH_MODE=api_key
HARNESS_API_KEY=

# Unattended service workloads require an API-key provider. Configure the model
# and credential through this protected file or the authenticated Settings UI.
AUDIT_LLM_PROVIDER=openai
AUDIT_LLM_MODEL=
OPENAI_API_KEY=
