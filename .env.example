AUDIT_LLM_PROVIDER=openai_codex
AUDIT_LLM_MODEL=gpt-5.1-codex
AUDIT_LLM_API_KEY=

# OpenAI Codex with local ChatGPT sign-in is the Community Edition default. Install Codex CLI
# explicitly and sign in with ChatGPT/Codex locally. Mock must be selected
# explicitly for deterministic development and CI jobs.
AUDIT_LLM_CODEX_COMMAND=codex
AUDIT_LLM_CODEX_MODEL=gpt-5.1-codex
AUDIT_LLM_CODEX_SANDBOX=read-only
AUDIT_LLM_CODEX_TIMEOUT_MS=600000
HARNESS_ENABLE_LOCAL_OAUTH_CONNECT=

# Provider governance. Model lists are exact allowlists. Per-run request/token
# budgets are capped again by the selected audit package.
AUDIT_LLM_ALLOWED_MODELS_OPENAI=gpt-5.4-mini,gpt-5.4,gpt-5.2,gpt-4.1,gpt-4.1-mini,gpt-4.1-nano
AUDIT_LLM_ALLOWED_MODELS_OPENAI_CODEX=gpt-5.1-codex,gpt-5.1-codex-mini
AUDIT_LLM_MAX_CONCURRENCY_OPENAI=2
AUDIT_LLM_MAX_CONCURRENCY_OPENAI_CODEX=1
AUDIT_LLM_MIN_REQUEST_INTERVAL_MS_OPENAI=250
AUDIT_LLM_MIN_REQUEST_INTERVAL_MS_OPENAI_CODEX=1000
AUDIT_LLM_MAX_RETRIES=3
AUDIT_LLM_BACKOFF_BASE_MS=500
AUDIT_LLM_CIRCUIT_FAILURE_THRESHOLD=3
AUDIT_LLM_CIRCUIT_COOLDOWN_MS=120000

# Live release validation is intentionally not enabled here. Never persist
# TETHERMARK_LIVE_MODEL_VALIDATION in .env; set its exact acknowledgement for
# one maintainer command only. See docs/live-model-validation.md.
TETHERMARK_LIVE_LLM_PROVIDER=
TETHERMARK_LIVE_LLM_MODEL=
TETHERMARK_LIVE_EVIDENCE_DIR=

# OSS runtime defaults
HARNESS_API_HOST=127.0.0.1
PORT=8787
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8788
WEB_UI_API_BASE_URL=http://127.0.0.1:8787

# OSS auth model
HARNESS_API_AUTH_MODE=none
HARNESS_API_KEY=
# Leave blank for normal localhost use. A non-loopback HARNESS_API_HOST or
# WEB_UI_HOST is rejected unless api_key auth, a 32+ character key, and the
# exact acknowledgement documented in README.md are all configured.
HARNESS_EXTERNAL_BIND_ACKNOWLEDGEMENT=

# Signed generic webhooks resolve only to public addresses by default. Set this
# only for an administrator-reviewed private HTTPS receiver and pair it with
# firewall or egress-proxy controls. Unsigned callbacks remain loopback-only.
HARNESS_ALLOW_PRIVATE_WEBHOOKS=0

# Persistence mode
# Default OSS runtime storage is SQLite-backed local storage.
# Shared-service installs can keep the checkout read-only by setting one
# writable artifact root. HARNESS_ENV_FILE selects an external protected env
# file; leave both blank for a normal checkout-local workstation install.
HARNESS_ENV_FILE=
HARNESS_ARTIFACT_ROOT=
# Postgres/Supabase bootstrap migrations are available with:
#   npm run scan -- migrate postgres --dry-run
#   npm run scan -- migrate postgres --database-url "<postgres-url>"
HARNESS_DB_MODE=local
HARNESS_LOCAL_DB_ROOT=
HARNESS_POSTGRES_URL=
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HARNESS_POSTGRES_SSL=true
HARNESS_PSQL_COMMAND=psql

# Governed learning is off by default. The API process runs its scheduler only
# after the operator enables both this switch and scheduled learning in Settings.
HARNESS_DISABLE_LEARNING_SCHEDULER=1
HARNESS_LEARNING_SCHEDULER_POLL_MS=60000

# Runtime/tooling toggles
PYTHON_BIN=python
HARNESS_DISABLE_LOCAL_BINARIES=0
HARNESS_DISABLE_PYTHON_WORKERS=0
HARNESS_ENABLE_HOST_SANDBOX_EXECUTION=0
HARNESS_SANDBOX_STEP_TIMEOUT_MS=

# Optional bundle export tuning
HARNESS_BUNDLE_EXPORT_ENABLED=
HARNESS_BUNDLE_EXPORT_RETENTION_DAYS=

# Optional artifact pruning defaults used by `npm run scan -- artifacts prune`.
# Pruning is explicit; these settings do not delete artifacts unless the command is run.
HARNESS_ARTIFACT_RETENTION_DAYS=
HARNESS_ARTIFACT_RETENTION_MAX_GB=
HARNESS_ARTIFACT_RETENTION_KIND=runs

# Agent-specific overrides. Set provider, model, and key per agent when needed.
AUDIT_LLM_PLANNER_PROVIDER=
AUDIT_LLM_PLANNER_MODEL=
AUDIT_LLM_PLANNER_API_KEY=

AUDIT_LLM_THREAT_MODEL_PROVIDER=
AUDIT_LLM_THREAT_MODEL_MODEL=
AUDIT_LLM_THREAT_MODEL_API_KEY=

AUDIT_LLM_EVIDENCE_SELECTION_PROVIDER=
AUDIT_LLM_EVIDENCE_SELECTION_MODEL=
AUDIT_LLM_EVIDENCE_SELECTION_API_KEY=

AUDIT_LLM_SUPERVISOR_PROVIDER=
AUDIT_LLM_SUPERVISOR_MODEL=
AUDIT_LLM_SUPERVISOR_API_KEY=

AUDIT_LLM_AREA_REVIEW_PROVIDER=
AUDIT_LLM_AREA_REVIEW_MODEL=
AUDIT_LLM_AREA_REVIEW_API_KEY=

AUDIT_LLM_REMEDIATION_PROVIDER=
AUDIT_LLM_REMEDIATION_MODEL=
AUDIT_LLM_REMEDIATION_API_KEY=
