{
  "type": "object",
  "required": ["schema_name", "schema_version", "generated_at", "tethermark_version", "payload"],
  "properties": {
    "schema_name": { "const": "executive_summary.v1" },
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string" },
    "tethermark_version": { "type": "string" },
    "compatibility": {
      "type": "object",
      "required": ["contract", "major_version", "minimum_reader_schema_version", "policy"],
      "properties": {
        "contract": { "const": "executive_summary.v1" },
        "major_version": { "const": 1 },
        "minimum_reader_schema_version": { "const": "1.0.0" },
        "policy": { "const": "same-major-additive" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["run_id", "status", "audit_package", "run_mode", "finding_count", "validation_completeness", "top_findings", "runtime_validation", "dispositions", "runtime_followups", "outstanding_actions"],
      "properties": {
        "run_id": { "type": "string" },
        "status": { "type": "string" },
        "audit_package": { "type": "string" },
        "run_mode": { "type": "string" },
        "rating": { "type": ["string", "null"] },
        "overall_score": { "type": ["number", "null"] },
        "static_score": { "type": ["number", "null"] },
        "methodology_version": { "type": ["string", "null"] },
        "static_baseline_version": { "type": ["string", "null"] },
        "dimension_scores": {
          "type": "object",
          "properties": {
            "repo_posture": { "type": "number" },
            "agentic_guardrails": { "type": "number" },
            "ai_data_exposure": { "type": "number" },
            "observability_auditability": { "type": "number" },
            "evidence_readiness": { "type": "number" }
          }
        },
        "assessed_commit": { "type": ["string", "null"] },
        "assessed_at": { "type": ["string", "null"] },
        "repository_url": { "type": ["string", "null"] },
        "target_class": { "type": ["string", "null"] },
        "automated_publishability_status": { "type": ["string", "null"] },
        "publishability_status": { "type": ["string", "null"] },
        "public_summary_safe": { "type": "boolean" },
        "automated_human_review_required": { "type": "boolean" },
        "human_review_required": { "type": "boolean" },
        "review_workflow_status": { "type": ["string", "null"] },
        "publication_basis": { "enum": ["automated", "review_approved", null] },
        "validation_completeness": {
          "type": "object",
          "required": ["status", "incomplete_tool_count", "incomplete_stage_count", "incomplete_model_invocation_count", "not_assessed_control_count", "runtime_blocked_count", "runtime_failed_count"],
          "properties": {
            "status": { "enum": ["complete", "incomplete"] },
            "prominent_warning": { "type": ["string", "null"] },
            "incomplete_tool_count": { "type": "number" },
            "incomplete_tools": { "type": "array" },
            "completed_fallback_provider_count": { "type": "number" },
            "completed_fallback_providers": { "type": "array" },
            "incomplete_stage_count": { "type": "number" },
            "incomplete_stages": { "type": "array" },
            "incomplete_model_invocation_count": { "type": "number" },
            "incomplete_model_invocations": { "type": "array" },
            "not_assessed_control_count": { "type": "number" },
            "not_assessed_controls": { "type": "array" },
            "expected_scope_gap_count": { "type": "number" },
            "expected_scope_gaps": { "type": "array" },
            "unexpected_not_assessed_control_count": { "type": "number" },
            "unexpected_not_assessed_controls": { "type": "array" },
            "runtime_blocked_count": { "type": "number" },
            "runtime_failed_count": { "type": "number" },
            "sandbox_attention_required": { "type": "boolean" }
          }
        },
        "finding_count": { "type": "number" },
        "top_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "title", "category", "severity", "confidence", "runtime_validation_status", "next_action", "disposition"],
            "properties": {
              "finding_id": { "type": "string" },
              "title": { "type": "string" },
              "category": { "type": "string" },
              "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
              "confidence": { "type": "number" },
              "evidence_sufficiency": { "type": "string" },
              "runtime_validation_status": { "enum": ["validated", "blocked", "failed", "recommended", "not_applicable"] },
              "next_action": { "type": "string" },
              "disposition": { "enum": ["open", "confirmed", "suppressed", "downgraded", "needs_validation", "waived"] }
            }
          }
        },
        "runtime_validation": {
          "type": "object",
          "required": ["validated_count", "blocked_count", "failed_count", "recommended_count"],
          "properties": {
            "validated_count": { "type": "number" },
            "blocked_count": { "type": "number" },
            "failed_count": { "type": "number" },
            "recommended_count": { "type": "number" }
          }
        },
        "dispositions": {
          "type": "object",
          "required": ["suppressed_count", "waived_count", "expired_count", "reopened_count", "needs_review_count", "active"],
          "properties": {
            "suppressed_count": { "type": "number" },
            "waived_count": { "type": "number" },
            "expired_count": { "type": "number" },
            "reopened_count": { "type": "number" },
            "needs_review_count": { "type": "number" },
            "active": { "type": "array" }
          }
        },
        "runtime_followups": {
          "type": "object",
          "required": ["required_count", "resolved_count", "rerun_requested_count", "completed_count", "outstanding"],
          "properties": {
            "required_count": { "type": "number" },
            "resolved_count": { "type": "number" },
            "rerun_requested_count": { "type": "number" },
            "completed_count": { "type": "number" },
            "outstanding": { "type": "array" }
          }
        },
        "remediation_summary": { "type": ["string", "null"] },
        "remediation_checklist": { "type": "array", "items": { "type": "string" } },
        "outstanding_actions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
