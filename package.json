{
  "name": "tethermark",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/packages/core-engine/src/test-runner.js",
    "exports:check": "npm run build --silent && node dist/packages/core-engine/src/export-maintenance.js check",
    "exports:refresh": "npm run build --silent && node dist/packages/core-engine/src/export-maintenance.js refresh",
    "release:check": "npm run build --silent && npm test --silent && npm run exports:check && npm run scan -- validate-fixtures",
    "oss": "npm run build --silent && node scripts/run-api-web.mjs",
    "oss:check": "npm run build --silent && node scripts/check-oss.mjs",
    "e2e:static-pi": "npm run build --silent && node scripts/check-static-pi-e2e.mjs",
    "e2e:static-pi-ui": "npm run build --silent && node scripts/check-static-pi-ui-e2e.mjs",
    "smoke:openai-codex-oauth": "npm run build --silent && node scripts/check-openai-codex-oauth.mjs",
    "smoke:openai-codex-oauth:real": "npm run build --silent && node scripts/check-openai-codex-oauth.mjs --real",
    "production:static-readiness": "npm run build --silent && npm test --silent && npm run exports:check --silent && npm run smoke:openai-codex-oauth --silent && npm run e2e:static-pi --silent && npm run e2e:static-pi-ui --silent",
    "production:static-release": "npm run production:static-readiness",
    "scan": "npm run build --silent && node dist/apps/cli/src/index.js",
    "scan:self": "npm run build --silent && node dist/apps/cli/src/index.js scan path . --output ./.artifacts/runs/self-scan-ts --mode static",
    "api": "npm run build --silent && node dist/apps/api-server/src/index.js",
    "mcp": "npm run build --silent && node dist/apps/mcp-server/src/index.js",
    "web": "npm run build --silent && node dist/apps/web-ui/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "playwright": "^1.56.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@types/pg": "^8.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "pg": "^8.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.5.0"
  }
}
